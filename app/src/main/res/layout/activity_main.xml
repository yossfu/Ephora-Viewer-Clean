<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1020">

        <FrameLayout
            android:id="@+id/loginView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/loginBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/login_bg"
                android:background="#101B3D" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/overlay_gradient" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:background="@drawable/card_bg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="EPHORA SL"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="#22D3EE" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Visor Second Life · Agni"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:textColor="#9AA7BD" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp" />

                        <EditText
                            android:id="@+id/userFull"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="usuario: nombre, Nombre o nombre.apellido"
                            android:textColor="#E8EDF7"
                            android:textColorHint="#9AA7BD"
                            android:background="@drawable/field_bg"
                            android:padding="14dp"
                            android:inputType="text"
                            android:minHeight="52dp" />

                        <EditText
                            android:id="@+id/userLopt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="apellido opcional (cuenta legacy)"
                            android:textColor="#E8EDF7"
                            android:textColorHint="#9AA7BD"
                            android:background="@drawable/field_bg"
                            android:padding="14dp"
                            android:inputType="text"
                            android:minHeight="52dp" />

                        <EditText
                            android:id="@+id/pw"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="password"
                            android:textColor="#E8EDF7"
                            android:textColorHint="#9AA7BD"
                            android:background="@drawable/field_bg"
                            android:padding="14dp"
                            android:inputType="textPassword"
                            android:minHeight="52dp" />

                        <CheckBox
                            android:id="@+id/chkShow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="mostrar password"
                            android:textColor="#E8EDF7"
                            android:buttonTint="#22D3EE" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Grid: Second Life Main (Agni)"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:textColor="#9AA7BD" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="12dp" />

                        <Button
                            android:id="@+id/btnEnter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ENTRAR"
                            android:textSize="18sp"
                            android:minHeight="56dp"
                            android:textColor="#06222A"
                            android:background="@drawable/btn_cyan" />

                        <ProgressBar
                            android:id="@+id/prog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/phase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textColor="#22D3EE" />

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <Button
                android:id="@+id/loginMenu"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:text="☰"
                android:textSize="20sp"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/mundo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#0B1020"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="☰"
                    android:textSize="20sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En el mundo"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#E8EDF7" />

                    <TextView
                        android:id="@+id/worldPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#22D3EE" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnTp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TP"
                    android:textSize="12sp"
                    android:textColor="#06222A"
                    android:background="@drawable/btn_cyan" />

                <Button
                    android:id="@+id/btn3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D"
                    android:textSize="12sp"
                    android:textColor="#06222A"
                    android:background="@drawable/btn_cyan" />

                <Button
                    android:id="@+id/btnChats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHATS"
                    android:textSize="12sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/chatListScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="8dp">

                <LinearLayout
                    android:id="@+id/chatList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <LinearLayout
                android:id="@+id/convBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8249; CHATS"
                    android:textSize="12sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <TextView
                    android:id="@+id/convTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCAL"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E8EDF7"
                    android:paddingLeft="12dp" />

            </LinearLayout>

            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/chatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EDF7"
                    android:textIsSelectable="true" />

            </ScrollView>

            <LinearLayout
                android:id="@+id/inputRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="decir en chat cercano"
                    android:textColor="#E8EDF7"
                    android:textColorHint="#9AA7BD"
                    android:background="@drawable/field_bg"
                    android:padding="14dp"
                    android:inputType="text"
                    android:minHeight="52dp" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENVIAR"
                    android:textSize="12sp"
                    android:textColor="#06222A"
                    android:background="@drawable/btn_cyan" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REINTENTAR"
                    android:textSize="10sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/joyL"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="◀"
                    android:textSize="15sp"
                    android:minHeight="52dp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/joyF"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▲"
                    android:textSize="15sp"
                    android:minHeight="52dp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/joyB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▼"
                    android:textSize="15sp"
                    android:minHeight="52dp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/joyR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▶"
                    android:textSize="15sp"
                    android:minHeight="52dp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/view3d"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@android:color/transparent">

            <android.opengl.GLSurfaceView
                android:id="@+id/surface3d"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.ephora.sl.VirtualJoystickView
                android:id="@+id/joystick3d"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp"
                android:elevation="24dp" />

            <Button
                android:id="@+id/btn3dCam"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:text="↻"
                android:textSize="22sp"
                android:textColor="#22D3EE"
                android:elevation="24dp"
                android:background="@drawable/btn_dark" />

            <Button
                android:id="@+id/btn3dExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:text="&#8249; CHAT"
                android:textSize="12sp"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

        </FrameLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0B1020">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSOLA DEBUG"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#22D3EE" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:nestedScrollingEnabled="true">

                <TextView
                    android:id="@+id/console"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="sin datos aun"
                    android:textSize="11sp"
                    android:textColor="#9AA7BD"
                    android:typeface="monospace"
                    android:textIsSelectable="true" />

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COPIAR"
                    android:textSize="11sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COMPARTIR"
                    android:textSize="11sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GUARDAR"
                    android:textSize="11sp"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

            </LinearLayout>

            <Button
                android:id="@+id/btnTech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ TÉCNICO (avanzado)"
                android:textSize="12sp"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

            <LinearLayout
                android:id="@+id/techBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solo diagnóstico. El flujo normal es ENTRAR."
                    android:textSize="11sp"
                    android:textColor="#9AA7BD" />

                <TextView
                    android:id="@+id/techUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#9AA7BD" />

                <CheckBox
                    android:id="@+id/chkHash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="probar hash estilo Lumiya (16)"
                    android:checked="true"
                    android:textColor="#E8EDF7"
                    android:buttonTint="#22D3EE" />

                <EditText
                    android:id="@+id/start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="last"
                    android:hint="start: last / home"
                    android:textColor="#E8EDF7"
                    android:textColorHint="#9AA7BD"
                    android:background="@drawable/field_bg"
                    android:padding="14dp"
                    android:inputType="text"
                    android:minHeight="52dp" />

                <EditText
                    android:id="@+id/mfa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="token 2FA 6 dig (si MFA)"
                    android:textColor="#E8EDF7"
                    android:textColorHint="#9AA7BD"
                    android:background="@drawable/field_bg"
                    android:padding="14dp"
                    android:inputType="number"
                    android:minHeight="52dp" />

                <Spinner
                    android:id="@+id/variant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:id="@+id/chkOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="usar OkHttp (recomendado)"
                    android:checked="true"
                    android:textColor="#E8EDF7"
                    android:buttonTint="#22D3EE" />

                <Button
                    android:id="@+id/btnLoginReal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOGIN REAL"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnGet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GET CONTROL (¿cgi vive?)"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnCaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROBAR CAPS (seed→caps→1 poll)"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnUdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROBAR UDP (circuito+handshake)"
                    android:textColor="#22D3EE"
                    android:background="@drawable/btn_dark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnT0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="T0"
                        android:textSize="12sp"
                        android:textColor="#22D3EE"
                        android:background="@drawable/btn_dark" />

                    <Button
                        android:id="@+id/btnT3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="T3"
                        android:textSize="12sp"
                        android:textColor="#22D3EE"
                        android:background="@drawable/btn_dark" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#0B1020">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHATS ABIERTOS"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#22D3EE" />

            <LinearLayout
                android:id="@+id/openChatsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMIGOS"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#22D3EE"
                android:paddingTop="16dp" />

            <LinearLayout
                android:id="@+id/onlineBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <LinearLayout
                android:id="@+id/offlineBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESOS"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#22D3EE"
                android:paddingTop="16dp" />

            <Button
                android:id="@+id/btnEndMundo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MUNDO"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

            <Button
                android:id="@+id/btnEndConsola"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONSOLA"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

            <Button
                android:id="@+id/btnEndReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMPARTIR REPORTE"
                android:textColor="#06222A"
                android:background="@drawable/btn_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUENTE FIREBASE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#22D3EE"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/streamDev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dev ?"
                android:textSize="12sp"
                android:textColor="#E8EDF7" />

            <Button
                android:id="@+id/btnStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STREAM: ON"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

            <Button
                android:id="@+id/btnSubir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUBIR AHORA"
                android:textColor="#22D3EE"
                android:background="@drawable/btn_dark" />

        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
