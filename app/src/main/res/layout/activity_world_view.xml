<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E13">

    <FrameLayout
        android:id="@+id/viewportCtn"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#A6000000"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#00000000"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="#FFFFFFFF"
            app:title="@string/world_title"
            app:titleTextColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/infoEl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFE6EAF0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/fpsEl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#FF9BE8B6"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.lumiyaviewer.lumiya.ui.world.MinimapView
        android:id="@+id/minimapEl"
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="104dp"
        android:layout_marginEnd="10dp"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#A6000000"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <!-- Diagnostic controls: content, camera framing, forced object and the
             full report panel. Every one of them is also visible in the HUD, so
             a screenshot says which state produced the picture. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_mode_region" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/frameBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_frame_agent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forceBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_force_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_diag" />
        </LinearLayout>

        <!-- Fase 2.9: prueba reversible de visibilidad. El probe de camara es
             geometria creada por este visor (no por Second Life) y el bloqueo de
             camara solo mueve la camara, nunca el objeto; ambos se apagan
             devolviendo la escena exactamente a su estado normal. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/probeBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_camera_probe_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockPrimBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_lock_prim_off" />

            <!-- Fase 2.10: seguir un objeto concreto. No cambia nada de como se
                 dibuja: activa el registro de su historia completa (protocolo y
                 escena) y el informe imprime su cadena entera junto a la de un
                 objeto sano. El localID se elige en tiempo de ejecucion. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/focusBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_focus_off" />

            <!-- TEST7: camara de prueba controlada (avatar). Reversible: solo
                 mueve la camara, nunca la escena; al apagar vuelve el encuadre
                 normal con sus mismos valores. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/avatarCamBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_avatarcam_off" />
        </LinearLayout>

        <!-- TEST11: boton unico de diagnostico. Los botones de TEST8/9/10 se
             conservan en el layout (codigo intacto y compilable) pero ocultos
             para no seguir acumulando controles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test8NoCullBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test8nocull_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test8BoxBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test8box_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test9Btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test9_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test10Btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test10_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test11Btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test11_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test12Btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test12_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test13Btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test13_off"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test14Btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_test14_off"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/test14StatusEl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/world_test14_status_ready"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/test14Bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/test13StatusEl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/world_test13_status_ready"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/test13Bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/test12StatusEl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/world_test12_status_ready"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/test12Bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/test11StatusEl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/world_test11_status_ready"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/test11Bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:max="5"
            android:progress="0"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/test10Bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- Fase 2.12: interruptores de escalado (A/B). Los cuatro son
             reversibles y no tocan los datos de los objetos; su estado se
             muestra en el HUD para que la captura diga con qué ajustes se tomó
             cada medida. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cullBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_cull_on" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/distBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_dist_on" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shadowBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_shadow_on" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lodBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_lod_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/turnLeftBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_turn_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forwardBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_forward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/turnRightBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_turn_right" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/strafeLeftBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backwardBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_backward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/strafeRightBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_right" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_run" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/upBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_down" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flyBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_fly" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_stop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recenterBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_recenter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_open_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nearbyBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/world_list_objects" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full-screen diagnostic report. Deliberately on top of everything: a
         screenshot of this screen is the evidence a black screen cannot give. -->
    <LinearLayout
        android:id="@+id/diagPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/world_diag_title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveReportBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:text="@string/world_diag_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyReportBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:text="@string/world_diag_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagCloseBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/world_diag_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/verdictsEl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFE082"
            android:textSize="11sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/diagEl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp"
                android:textColor="#FFB9F6CA"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
